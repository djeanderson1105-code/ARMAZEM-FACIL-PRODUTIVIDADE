      "components": [
        "Matriz14Areas5STable",
        "GaugeAtingimentoMeta5S",
        "AuditForm5SSensos",
        "HistoricoAuditoriasCard"
      ],
      "interactions": [
        "click_auditar_area → abrir_modal_checklist_5s_especifico_area",
        "filter_status_meta → filtrar_áreas_atingido_vs_fora_da_meta"
      ]
    },
    {
      "id": "view_11_cadastros_acessos",
      "name": "Cadastros / Controle de Acessos",
      "route": "/cadastros-acessos",
      "description": "Módulo administrativo para cadastro mestre de SKUs Ambev, tabela de conversão e matriz de permissões dos 4 perfis.",
      "components": [
        "CatálogoProdutosAmbevTable",
        "MatrizPerfisPermissoesTable",
        "ManualOverrideAuditPanel",
        "ParametrosArmazemCard"
      ],
      "interactions": [
        "edit_fator_sku → atualizar_conversao_cx_hl_globalmente",
        "toggle_permissao_perfil → aplicar_subscricao_manual_de_acesso"
      ]
    }
  ],
  "components": {
    "ChecklistModal5S": {
      "type": "blocking-modal",
      "props": {
        "title": "Checklist de 5S e Início de Jornada - Armazém Ambev Guarabira",
        "template_id": "5s_armazem_guarabira_v1",
        "blocking": true
      },
      "campos": [
        {"id": "1s_utilizacao", "label": "1S - Utilização (Seiri)", "required": true, "type": "boolean-checkbox"},
        {"id": "2s_organizacao", "label": "2S - Organização (Seiton)", "required": true, "type": "boolean-checkbox"},
        {"id": "3s_limpeza", "label": "3S - Limpeza (Seiso)", "required": true, "type": "boolean-checkbox"},
        {"id": "4s_padronizacao", "label": "4S - Padronização (Seiketsu)", "required": true, "type": "boolean-checkbox"},
        {"id": "5s_disciplina", "label": "5S - Disciplina (Shitsuke)", "required": true, "type": "boolean-checkbox"},
        {"id": "observacao_auditoria", "label": "Observações do Auditor", "required": false, "type": "textarea"}
      ],
      "validacoes": "Todos os 5 sensos obrigatórios devem ser marcados 'Conforme' para liberar o botão de confirmação e desbloquear a workstation."
    },
    "WorkstationCriticosRecolhimentoTable": {
      "type": "data-table",
      "props": {
        "columns": ["farol", "codigo", "produto_descricao", "qtd_total", "vencimento", "dias_p_vencer", "setor_origem", "valoracao_rs", "acoes"],
        "min_font_size": "13px font-mono"
      },
      "campos": ["demanda_id", "produto_codigo", "lote", "quantidade", "dias_estoque"],
      "validacoes": "Destaque visual em vermelho para itens com vencimento <= 30 dias e amarelo para 31-45 dias."
    },
    "PlanoAcao5PorquesForm": {
      "type": "form-modal",
      "props": {
        "title": "Plano de Ação - Análise de Causa Raiz (5 Porquês)"
      },
      "campos": [
        {"id": "desvio_id", "label": "Desvio Referência", "type": "select", "required": true},
        {"id": "porque_1", "label": "1º Por quê? (Causa Imediata)", "type": "text", "required": true},
        {"id": "porque_2", "label": "2º Por quê?", "type": "text", "required": true},
        {"id": "porque_3", "label": "3º Por quê?", "type": "text", "required": true},
        {"id": "porque_4", "label": "4º Por quê?", "type": "text", "required": true},
        {"id": "porque_5", "label": "5º Por quê? (Causa Raiz)", "type": "text", "required": true},
        {"id": "acao_corretiva", "label": "Ação Corretiva Proposta", "type": "textarea", "required": true},
        {"id": "responsavel", "label": "Responsável", "type": "select", "required": true},
        {"id": "prazo_conclusao", "label": "Prazo de Conclusão", "type": "date", "required": true}
      ],
      "validacoes": "Todos os 5 porquês e a ação corretiva devem ter no mínimo 10 caracteres preenchidos."
    }
  },
  "interactions": [
    {
      "id": "int_01_toggle_unidade",
      "trigger": "User clica no toggle de Unidade no Header (cx / HL / R$)",
      "action": "Altera o estado global `unitToggle` e salva a preferência no localStorage.",
      "effect": "Re-formata instantaneamente todas as séries temporais, colunas de tabelas e KPI cards convertendo quantidades em caixas para hectolitros (x hectolitro_por_unidade) ou Reais (x valor_unitario)."
    },
    {
      "id": "int_02_iniciar_jornada_5s",
      "trigger": "User clica no botão 'Iniciar Jornada' ou abre a aplicação no início do turno",
      "action": "Dispara o modal 'ChecklistModal5S' com layout bloqueante.",
      "effect": "Impede qualquer navegação ou edição no sistema até que o usuário responda os 5 itens do checklist 5S e envie o formulário."
    },
    {
      "id": "int_03_filtro_calendarizado",
      "trigger": "User altera o período no seletor calendarizado (dia-a-dia ou mês-a-mês) ou escolhe um Quick Range",
      "action": "Executa re-fetch/filtragem local dos dados de demandas e auditorias.",
      "effect": "Atualiza todos os gráficos e relatórios para refletirem exatamente o intervalo temporal selecionado."
    },
    {
      "id": "int_04_edicao_inline_conferente",
      "trigger": "Conferente altera o campo de quantidade física na view Future Shelf",
      "action": "Recalcula dias_estoque e estoque_disponivel em tempo real.",
      "effect": "Exibe badge de divergência se a contagem física for menor que a do WMS/OCR e registra log de auditoria."
    }
  ]
}
