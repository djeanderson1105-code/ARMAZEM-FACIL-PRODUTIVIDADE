{
  "tokens": {
    "cores_principais": {
      "ambev_navy": "#002F6C",
      "ambev_gold": "#F2A900",
      "success_emerald": "#10B981",
      "danger_red": "#EF4444",
      "warning_amber": "#F59E0B",
      "neutral_slate": "#1E293B",
      "neutral_light": "#F8FAFC",
      "card_border": "#E2E8F0"
    },
    "fonte_base": "Inter, Plus Jakarta Sans, system-ui, sans-serif",
    "min_font_size": "13px (estritamente aplicado para dados numéricos, tabelas e registros)",
    "typography": {
      "h1": "font-bold text-2xl text-slate-900 tracking-tight",
      "h2": "font-semibold text-lg text-slate-800",
      "data_cell": "text-[13px] font-mono leading-tight text-slate-700",
      "badge": "text-[12px] font-medium px-2.5 py-0.5 rounded-full"
    },
    "spacing_rules": {
      "outer_padding": "p-6 md:p-8",
      "card_padding": "p-5",
      "gap": "gap-4 md:gap-6",
      "nested_radius_math": "Radius Interno = Radius Externo (12px) - Padding (16px) = 4px"
    }
  },
  "header_padrao": {
    "component_id": "header_padrao_cco_v1",
    "title": "Armazém Ambev Guarabira — Workstation CCO",
    "seletor_calendarizado": {
      "dia_a_dia": {
        "type": "date-range-picker",
        "format": "YYYY-MM-DD",
        "placeholder": "Selecione o intervalo de dias"
      },
      "mes_a_mes": {
        "type": "month-range-picker",
        "format": "YYYY-MM",
        "placeholder": "Selecione o intervalo de meses"
      }
    },
    "quick_range": {
      "type": "segmented-control",
      "options": ["Hoje", "Últimos 7 dias", "Mês atual", "Ano até hoje"],
      "default": "Últimos 7 dias"
    },
    "filtros": [
      {
        "id": "filter_local",
        "label": "Local / Armazém",
        "options": ["Todos", "Armazém Guarabira - Pátio Principal", "Depósito Cervejas", "Depósito RGB/Soft Drinks"],
        "default": "Armazém Guarabira - Pátio Principal"
      },
      {
        "id": "filter_area",
        "label": "Área Operacional",
        "options": ["Todas", "PICKING", "ÁREA DE CARREGAMENTO", "CENTRAL", "DESPEJO", "ÁREA MKT PLACE", "PNC", "RECICLÁVEIS", "REFUGO", "DEVOLUÇÃO", "REPACK", "EMPILHADEIRA 1", "EMPILHADEIRA 2", "FROTA DA ENTREGA"],
        "default": "Todas"
      },
      {
        "id": "filter_responsavel",
        "label": "Responsável",
        "options": ["Todos", "DEJEAN", "OZENILDO", "GLADSON", "PAULO", "RONILDO", "MARIVALDO", "DIOGENES"],
        "default": "Todos"
      }
    ],
    "toggle_unidade": {
      "type": "persistent-toggle",
      "storage_key": "cco_unit_toggle_preference",
      "options": ["Caixas (cx)", "Hectolitro (HL)", "Reais (R$)"],
      "default": "Caixas (cx)",
      "behavior": "Converte instantaneamente os dados de caixas usando o fator hectolitro_por_unidade e valor_unitario do catálogo."
    },
    "cco_status_badge": {
      "status": "OPERATIONAL",
      "label": "CCO Guarabira On-line",
      "last_sync": "2026-08-05T07:53:21-07:00"
    }
  },
  "views": [
    {
      "id": "view_01_visao_geral",
      "name": "Visão Geral",
      "route": "/overview",
      "description": "Painel executivo com KPIs em tempo real, farol de itens em recolhimento crítico e resumo da Matriz 5S das 13 operações.",
      "components": [
        "ExecutiveKPIGrid",
        "WorkstationCriticosRecolhimentoTable",
        "MatrizGeral13OperacoesCard",
        "QuickActionDrawer"
      ],
      "interactions": [
        "click_iniciar_jornada → abrir_modal_checklist_5s (bloqueia navegação até submissão)",
        "toggle_unidade → recalcular_kpis_e_tabelas_cx_hl_rs",
        "click_item_critico → abrir_drilldown_lote_recolhimento"
      ]
    },
    {
      "id": "view_02_desvios_acoes",
      "name": "Desvios & Ações",
      "route": "/desvios",
      "description": "Módulo de identificação de desvios OCR de validade e formulação de Planos de Ação baseados nos 5 Porquês.",
      "components": [
        "DesviosOCRTable",
        "PlanoAcao5PorquesForm",
        "TimelineResolucaoDesvios",
        "ConflictsReportAlert"
      ],
      "interactions": [
        "filter_status_desvio → filtrar_desvios_pendentes_em_analise_concluidos",
        "click_novo_plano_acao → abrir_modal_5_porques",
        "submit_5_porques → atualizar_status_desvio_para_em_tratativa"
      ]
    },
    {
      "id": "view_03_agenda_executiva",
      "name": "Agenda Executiva",
      "route": "/agenda",
      "description": "Calendário operacional DPO para agendamento de auditorias, pauta da reunião matinal e rotinas de supervisão.",
      "components": [
        "CalendarAuditoriasDPO",
        "MorningMeetingPlanner",
        "RoutineEventsList",
        "AuditorAssignmentCard"
      ],
      "interactions": [
        "click_data_calendario → filtrar_eventos_do_dia",
        "click_nova_auditoria → agendar_auditoria_e_notificar_responsavel"
      ]
    },
    {
      "id": "view_04_diario_bordo",
      "name": "Diário de Bordo (Colaborador e ADM)",
      "route": "/diario",
      "description": "Registro contínuo de passagem de turno, avarias de produtos no pátio e ocorrências operacionais por colaborador.",
      "components": [
        "PassagemTurnoForm",
        "RegistroAvariasQuebrasCard",
        "MuralOcorrenciasTimeline",
        "FiltroVisaoColaboradorADM"
      ],
      "interactions": [
        "toggle_visao_adm → exibir_logs_completos_e_editar_registros",
        "submit_passagem_turno → registrar_assnatura_digital_e_fechar_turno"
      ]
    },
    {
      "id": "view_05_fluxograma_demandas",
      "name": "Fluxograma de Demandas",
      "route": "/fluxograma",
      "description": "Quadro Kanban interativo para acompanhamento do fluxo de vida das demandas de vencimento e future shelf.",
      "components": [
        "KanbanBoardDemandas",
        "CardDemandaGiro",
        "KanbanStageColumnHeaders",
        "ModalDetalharDemanda"
      ],
      "interactions": [
        "drag_drop_card → mover_demanda_entre_estagios_entrada_triagem_em_acao_concluido",
        "click_card → abrir_modal_detalhes_demanda_com_fator_conversao"
      ]
    },
    {
      "id": "view_06_reunioes_treinamentos",
      "name": "Reuniões & Treinamentos",
      "route": "/reunioes",
      "description": "Central de gestão de Padrões Operacionais (POPs), lista de presença em treinamentos e atas de reuniões matinais.",
      "components": [
        "BibliotecaPOPsDPO",
        "ListaPresencaDigitalForm",
        "AtaReuniaoMatinalCard",
        "TreinamentoStatusBadge"
      ],
      "interactions": [
        "click_assinar_treinamento → registrar_presenca_colaborador",
        "download_pop_pdf → abrir_visualizador_padrao_operacional"
      ]
    },
    {
      "id": "view_07_produtividade",
      "name": "Produtividade (Repack / Despejo / Quebras)",
      "route": "/produtividade",
      "description": "Ranking de desempenho dos operadores, cronômetro de tempo de Repack e controle de hectolitros despejados.",
      "components": [
        "OperationsRankingMatrix",
        "CronometroRepackCard",
        "ModuloDespejoQuebrasCard",
        "ModalDrilldownColaborador"
      ],
      "interactions": [
        "click_colaborador_ranking → abrir_modal_drilldown_historico_produtividade",
        "start_cronometro_repack → iniciar_contagem_tempo_e_caixas"
      ]
    },
    {
      "id": "view_08_gestao_escoamento",
      "name": "Gestão de Escoamento",
      "route": "/escoamento",
