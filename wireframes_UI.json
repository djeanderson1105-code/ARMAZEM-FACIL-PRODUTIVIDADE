      ]
    },
    {
      "id": "view_09_future_shelf_conferente",
      "name": "Future Shelf / Conferente",
      "route": "/future-shelf",
      "description": "Painel operacional para conferentes realizarem contagem física no pátio e ajustarem saldos de estoque inline.",
      "components": [
        "FutureShelfTable",
        "ConferenteInlineQtyInput",
        "DivergenciaPatioBadge",
        "BotaoLancamentoRapido"
      ],
      "interactions": [
        "change_inline_qty → recalcular_dias_estoque_e_destacar_divergencia",
        "click_salvar_conferencia → atualizar_saldo_fisico_com_audit_trail"
